+package com.stradaos.launcher;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.os.SystemClock;
+import android.view.View;
+
+/**
+ * Panel central alternativo al mapa: un auto rojo (hatchback compacto) visto desde atrás, con las luces traseras
+ * encendidas, avanzando por una autopista de tres carriles. Los bordes de la calzada usan el color de acento del tema
+ * y los colores del cielo y del asfalto salen del tema (claro / oscuro). Con velocidad, las rayas, el guardarraíl y las
+ * farolas avanzan al ritmo de la velocidad real; detenido, la escena queda quieta y no gasta batería.
+ *
+ * Todo se dibuja con código (sin imágenes). Lo que no se mueve (cielo, calzada, auto) se guarda en un bitmap y solo se
+ * repinta lo que avanza, así que va ligero también en pantallas lentas.
+ */
+public class RoadScene extends View {
+    private static final float ZFAR = 170f, ZC = 7f, CAR_M = 1.8f, ROAD_HALF = 5.4f, SHOULDER = 7.3f;
+
+    private final float s, radius;
+    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path path = new Path();
+    private final Path clip = new Path();
+    private final RectF rf = new RectF();
+    private final int[] c2 = new int[2];
+    private final float[] p2 = {0f, 1f};
+
+    private float topInset, bottomInset;
+    private float speed, shown;     // km/h pedidos y km/h mostrados (suavizados)
+    private double dist;            // metros recorridos (módulo 120: todos los períodos lo dividen)
+    private float t;
+    private long last;
+
+    // geometría
+    private int lw, lh, lkey;
+    private float cx, hz, f, hc, zNear, carW, ycb;
+    private int skyHz, ink;
+    private boolean light;
+    private int bg, accent;
+
+    private Bitmap bgBmp, carBmp;
+    private float carOx, carOy;
+    private Shader hazeShader;
+
+    public RoadScene(Context ctx, float scale, float radiusPx) {
+        super(ctx);
+        s = scale;
+        radius = radiusPx;
+        topInset = 52 * s;
+        bottomInset = 108 * s;
+        setLayerType(LAYER_TYPE_SOFTWARE, null);   // clipPath fiable en GPUs antiguas (igual que el mapa)
+    }
+
+    /** Márgenes en px: arriba (etiqueta del GPS) y abajo (panel de Android Auto / CarPlay). El auto queda entre los dos. */
+    public void setInsets(float topPx, float bottomPx) {
+        topInset = topPx;
+        bottomInset = bottomPx;
+        lw = 0;   // fuerza reconstruir
+        postInvalidate();
+    }
+
+    /** Velocidad real en km/h (0 = detenido). */
+    public void setSpeed(float kmh) {
+        speed = Math.max(0f, kmh);
+        postInvalidate();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        release();
+        lw = 0;
+        last = 0;
+    }
+
+    private void release() {
+        if (bgBmp != null) { bgBmp.recycle(); bgBmp = null; }
+        if (carBmp != null) { carBmp.recycle(); carBmp = null; }
+    }
+
+    // ───────────────────────── colores ─────────────────────────
+
+    private static int mix(int a, int b, float k) {
+        int aa = (int) ((a >>> 24) + ((b >>> 24) - (a >>> 24)) * k);
+        int r = (int) (((a >> 16) & 255) + (((b >> 16) & 255) - ((a >> 16) & 255)) * k);
+        int g = (int) (((a >> 8) & 255) + (((b >> 8) & 255) - ((a >> 8) & 255)) * k);
+        int bl = (int) ((a & 255) + ((b & 255) - (a & 255)) * k);
+        return (aa << 24) | (r << 16) | (g << 8) | bl;
+    }
+
+    private static int al(int c, float a) {
+        return (((int) (255 * Math.max(0f, Math.min(1f, a)))) << 24) | (c & 0x00FFFFFF);
+    }
+
+    private void fill(int color) {
+        p.setShader(null);
+        p.setStyle(Paint.Style.FILL);
+        p.setColor(color);
+    }
+
+    private void fillShader(Shader sh) {
+        p.setStyle(Paint.Style.FILL);
+        p.setColor(0xFFFFFFFF);
+        p.setShader(sh);
+    }
+
+    private void stroke(int color, float width) {
+        p.setShader(null);
+        p.setStyle(Paint.Style.STROKE);
+        p.setColor(color);
+        p.setStrokeWidth(Math.max(1f, width));
+    }
+
+    private Shader lin(float x0, float y0, float x1, float y1, int a, int b) {
+        c2[0] = a; c2[1] = b;
+        return new LinearGradient(x0, y0, x1, y1, c2.clone(), p2, Shader.TileMode.CLAMP);
+    }
+
+    private Shader lin3(float x0, float y0, float x1, float y1, int a, int b, int c, float mid) {
+        return new LinearGradient(x0, y0, x1, y1, new int[]{a, b, c}, new float[]{0f, mid, 1f}, Shader.TileMode.CLAMP);
+    }
+
+    private Shader rad(float r, int a, int b) {
+        c2[0] = a; c2[1] = b;
+        return new RadialGradient(0, 0, r, c2.clone(), p2, Shader.TileMode.CLAMP);
+    }
+
+    private Shader rad3(float r, int a, int b, int c, float mid) {
+        return new RadialGradient(0, 0, r, new int[]{a, b, c}, new float[]{0f, mid, 1f}, Shader.TileMode.CLAMP);
+    }
+
+    private void rr(Canvas c, float x, float y, float w, float h, float r) {
+        rf.set(x, y, x + w, y + h);
+        c.drawRoundRect(rf, r, r, p);
+    }
+
+    /** Dibuja un degradado radial centrado en (x, y), con alto escalado por sy (para óvalos). */
+    private void glow(Canvas c, float x, float y, float r, float sy, Shader sh) {
+        c.save();
+        c.translate(x, y);
+        c.scale(1f, sy);
+        fillShader(sh);
+        c.drawRect(-r * 1.05f, -r * 1.05f, r * 1.05f, r * 1.05f, p);
+        c.restore();
+        p.setShader(null);
+    }
+
+    // ───────────────────────── proyección ─────────────────────────
+
+    private float sx(float x, float z) { return cx + x * f / z; }
+    private float sy(float z, float ht) { return hz + (hc - ht) * f / z; }
+    private float clampZ(float z) { return Math.max(zNear, Math.min(ZFAR, z)); }
+
+    /** Franja del suelo entre x0..x1 y distancias za..zb (con alturas ha..hb para el guardarraíl). */
+    private void strip(Canvas c, float x0, float x1, float za, float zb, float ha, float hb, int col) {
+        za = clampZ(za);
+        zb = clampZ(zb);
+        if (zb <= za) return;
+        fill(col);
+        path.reset();
+        path.moveTo(sx(x0, za), sy(za, ha));
+        path.lineTo(sx(x1, za), sy(za, ha));
+        path.lineTo(sx(x1, zb), sy(zb, hb));
+        path.lineTo(sx(x0, zb), sy(zb, hb));
+        path.close();
+        c.drawPath(path, p);
+    }
+
+    private void layout(int w, int h) {
+        cx = w / 2f;
+        hz = h * 0.31f;
+        ycb = h - bottomInset;
+        carW = Math.min(w * 0.30f, 0.92f * (ycb - topInset) / 0.82f);
+        if (carW < 20) carW = 20;
+        f = carW * ZC / CAR_M;
+        hc = (ycb - hz) * ZC / f;
+        if (hc < 0.9f) hc = 0.9f;
+        zNear = hc * f / (h - hz);
+        light = Main.LIGHT;
+        bg = Main.CARD;
+        accent = Main.RED;
+        ink = light ? 0xFF2A2D35 : 0xFFFFFFFF;
+        skyHz = light ? mix(0xFFF4E9E4, accent, 0.20f) : mix(bg, accent, 0.42f);
+        hazeShader = lin(0, hz - 2, 0, hz + h * 0.16f, al(skyHz, 0.95f), al(skyHz, 0f));
+    }
+
+    private int themeKey() { return Main.RED * 31 + Main.CARD * 17 + (Main.LIGHT ? 1 : 0); }
+
+    private void rebuild(int w, int h) {
+        lw = w;
+        lh = h;
+        lkey = themeKey();
+        layout(w, h);
+        release();
+        try {
+            bgBmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+            drawBackground(new Canvas(bgBmp), w, h);
+            int cw = (int) Math.ceil(carW * 2.1f), ch = (int) Math.ceil(carW * 1.45f);
+            carBmp = Bitmap.createBitmap(cw, ch, Bitmap.Config.ARGB_8888);
+            carOx = carW * 1.05f;
+            carOy = carW * 1.2f;
+            drawCar(new Canvas(carBmp), carOx, carOy, carW);
+        } catch (Throwable e) {   // sin memoria: se dibuja directo, más lento pero igual
+            release();
+        }
+    }
+
+    // ───────────────────────── dibujo ─────────────────────────
+
+    @Override
+    protected void onDraw(Canvas cv) {
+        int w = getWidth(), h = getHeight();
+        if (w < 10 || h < 10) return;
+        if (w != lw || h != lh || themeKey() != lkey) rebuild(w, h);
+
+        long now = SystemClock.uptimeMillis();
+        float dt = last == 0 ? 0f : Math.min(0.1f, (now - last) / 1000f);
+        last = now;
+        shown += (speed - shown) * Math.min(1f, dt * 4f);
+        if (Math.abs(speed - shown) < 0.3f) shown = speed;
+        dist = (dist + shown / 3.6f * dt) % 120.0;
+        t += dt;
+
+        clip.reset();
+        rf.set(0, 0, w, h);
+        clip.addRoundRect(rf, radius, radius, Path.Direction.CW);
+        cv.save();
+        cv.clipPath(clip);
+
+        if (bgBmp != null) cv.drawBitmap(bgBmp, 0, 0, null);
+        else drawBackground(cv, w, h);
+        drawMoving(cv, w, h);
+
+        boolean moving = shown > 0.2f;
+        float sway = moving ? (float) Math.sin(t * 1.7f) * 0.004f * carW : 0f;
+        float bob = moving ? (float) Math.sin(t * 5.3f) * 0.0025f * carW : 0f;
+        if (carBmp != null) cv.drawBitmap(carBmp, cx + sway - carOx, ycb + bob - carOy, null);
+        else drawCar(cv, cx + sway, ycb + bob, carW);
+        cv.restore();
+
+        // ~30 cuadros por segundo mientras haya velocidad pedida o el movimiento se esté frenando; detenido no se repinta
+        if (speed > 0.2f || moving) postInvalidateDelayed(33);
+        else last = 0;
+    }
+
+    /** Lo que no se mueve: cielo, estrellas, siluetas, suelo, calzada, hombros y líneas de borde con el acento. */
+    private void drawBackground(Canvas c, int w, int h) {
+        final int skyTop = light ? mix(bg, 0xFF9FB4CC, 0.55f) : mix(bg, 0xFF000000, 0.45f);
+        final int terrain = light ? mix(bg, 0xFF8E9AA3, 0.45f) : mix(bg, 0xFF000000, 0.55f);
+        final int asphalt = light ? 0xFF6D727C : 0xFF2B2E37;
+        final int asphaltFar = mix(asphalt, skyHz, 0.35f);
+
+        // cielo
+        fillShader(lin(0, 0, 0, hz, skyTop, skyHz));
+        c.drawRect(0, 0, w, hz + 1, p);
+        p.setShader(null);
+        if (!light) {   // estrellas fijas
+            for (int i = 0; i < 40; i++) {
+                float a = (float) (Math.sin(i * 91.7) * 43758.5), b = (float) (Math.sin(i * 12.9) * 14375.3), d = (float) (Math.sin(i * 7.1) * 999.0);
+                a -= (float) Math.floor(a);
+                b -= (float) Math.floor(b);
+                d -= (float) Math.floor(d);
+                fill(al(0xFFFFFFFF, 0.18f + 0.25f * d));
+                float px = a * w, py = b * hz * 0.7f, sz = 1.1f * s;
+                c.drawRect(px, py, px + sz, py + sz, p);
+            }
+        }
+        // brillo del horizonte con el color de acento
+        glow(c, cx, hz, w * 0.62f, 0.30f, rad3(w * 0.62f, al(accent, light ? 0.28f : 0.46f), al(accent, light ? 0.10f : 0.16f), al(accent, 0f), 0.5f));
+        // siluetas lejanas (colinas / ciudad), más bajas donde está la ruta
+        fill(mix(skyHz, light ? 0xFF6E7A88 : 0xFF000000, light ? 0.35f : 0.55f));
+        path.reset();
+        path.moveTo(0, hz);
+        for (int i = 0; i <= 60; i++) {
+            float x = w * i / 60f;
+            float n = ((float) (Math.sin(x * 0.013) * 0.5 + Math.sin(x * 0.047 + 1.3) * 0.3 + Math.sin(x * 0.151) * 0.2) + 1f) / 2f;
+            float bump = Math.abs(x - cx) < w * 0.12f ? 0.35f : 1f;
+            path.lineTo(x, hz - (0.010f + 0.050f * n) * h * bump);
+        }
+        path.lineTo(w, hz);
+        path.close();
+        c.drawPath(path, p);
+
+        // suelo
+        fillShader(lin3(0, hz, 0, h, mix(terrain, skyHz, 0.45f), terrain, mix(terrain, 0xFF000000, 0.3f), 0.5f));
+        c.drawRect(0, hz, w, h, p);
+        p.setShader(null);
+
+        // calzada con degradado vertical (neblina lejana → asfalto)
+        c.save();
+        path.reset();
+        path.moveTo(sx(-SHOULDER, ZFAR), sy(ZFAR, 0));
+        path.lineTo(sx(SHOULDER, ZFAR), sy(ZFAR, 0));
+        path.lineTo(sx(SHOULDER, zNear), h);
+        path.lineTo(sx(-SHOULDER, zNear), h);
+        path.close();
+        c.clipPath(path);
+        fillShader(lin3(0, hz, 0, h, asphaltFar, mix(asphalt, asphaltFar, 0.35f), asphalt, 0.35f));
+        c.drawRect(0, hz, w, h, p);
+        p.setShader(null);
+        c.restore();
+
+        // hombros
+        int shade = al(0xFF000000, light ? 0.10f : 0.22f);
+        strip(c, -SHOULDER, -ROAD_HALF, zNear, ZFAR, 0, 0, shade);
+        strip(c, ROAD_HALF, SHOULDER, zNear, ZFAR, 0, 0, shade);
+        // líneas de borde con el acento (+ halo)
+        strip(c, -ROAD_HALF - 0.18f, -ROAD_HALF + 0.30f, zNear, ZFAR, 0, 0, al(accent, 0.22f));
+        strip(c, ROAD_HALF - 0.30f, ROAD_HALF + 0.18f, zNear, ZFAR, 0, 0, al(accent, 0.22f));
+        strip(c, -ROAD_HALF, -ROAD_HALF + 0.17f, zNear, ZFAR, 0, 0, al(accent, 0.95f));
+        strip(c, ROAD_HALF - 0.17f, ROAD_HALF, zNear, ZFAR, 0, 0, al(accent, 0.95f));
+
+        // cuerpo del guardarraíl (banda lateral y dos rieles)
+        int railBand = al(mix(ink, bg, light ? 0.35f : 0.55f), 0.35f);
+        int rail = al(mix(ink, bg, light ? 0.35f : 0.55f), 0.55f);
+        for (int sd = -1; sd <= 1; sd += 2) {
+            float xr = sd * 7.9f;
+            fill(railBand);
+            path.reset();
+            path.moveTo(sx(xr, zNear), sy(zNear, 0.82f));
+            path.lineTo(sx(xr, ZFAR), sy(ZFAR, 0.82f));
+            path.lineTo(sx(xr, ZFAR), sy(ZFAR, 0.48f));
+            path.lineTo(sx(xr, zNear), sy(zNear, 0.48f));
+            path.close();
+            c.drawPath(path, p);
+            strip(c, xr - 0.05f, xr + 0.05f, zNear, ZFAR, 0.50f, 0.50f, rail);
+            strip(c, xr - 0.05f, xr + 0.05f, zNear, ZFAR, 0.80f, 0.80f, rail);
+        }
+    }
+
+    /** Lo que avanza con la velocidad: rayas de carril, postes del guardarraíl y farolas; y la neblina del horizonte. */
+    private void drawMoving(Canvas c, int w, int h) {
+        final float d = (float) dist;
+        // rayas discontinuas a los lados del auto (carril central)
+        final float period = 10f, dash = 3.2f;
+        for (int k = (int) Math.floor((zNear + d) / period) - 1; k * period - d < ZFAR; k++) {
+            float z0 = k * period - d, z1 = z0 + dash;
+            if (z1 < zNear) continue;
+            float fade = 1f - Math.min(1f, Math.max(0f, (z0 - 30f) / (ZFAR - 30f)));
+            float near = Math.min(1f, Math.max(0f, (z0 - 5f) / 5f));
+            int col = al(ink, 0.70f * fade * near);
+            strip(c, -1.8f - 0.07f, -1.8f + 0.07f, z0, z1, 0, 0, col);
+            strip(c, 1.8f - 0.07f, 1.8f + 0.07f, z0, z1, 0, 0, col);
+        }
+        // postes del guardarraíl
+        int post = al(mix(ink, bg, 0.5f), 0.7f);
+        for (int sd = -1; sd <= 1; sd += 2) {
+            float xr = sd * 7.9f;
+            for (int k = (int) Math.floor((zNear + d) / 6f) - 1; k * 6f - d < ZFAR * 0.8f; k++) {
+                float z = k * 6f - d;
+                if (z < zNear) continue;
+                float wpx = Math.max(1f, 0.12f * f / z);
+                float x = sx(xr, z), y0 = sy(z, 0.85f), y1 = sy(z, 0);
+                fill(post);
+                c.drawRect(x - wpx / 2, y0, x + wpx / 2, y1, p);
+            }
+        }
+        // farolas alternadas con halo cálido
+        int pole = mix(ink, bg, light ? 0.4f : 0.6f);
+        for (int sd = -1; sd <= 1; sd += 2) {
+            final float per = 40f, off = sd < 0 ? 0f : 20f;
+            for (int k = (int) Math.floor((zNear + d - off) / per) - 1; k * per + off - d < ZFAR; k++) {
+                float z = k * per + off - d;
+                if (z < 16f) continue;
+                float xb = sd * 9.2f, ph = 7.5f;
+                float px = sx(xb, z), pb = sy(z, 0), pt = sy(z, ph);
+                float wpx = Math.max(1.2f, 0.22f * f / z);
+                float fade = (1f - Math.min(1f, Math.max(0f, (z - 60f) / (ZFAR - 60f)))) * Math.min(1f, (z - 16f) / 12f);
+                fill(al(pole, 0.9f * fade));
+                c.drawRect(px - wpx / 2, pt, px + wpx / 2, pb, p);
+                float lx = sx(xb - sd * 2.2f, z);
+                stroke(al(pole, 0.9f * fade), wpx * 0.8f);
+                c.drawLine(px, pt, lx, pt, p);
+                float gr = Math.max(6f, 3.2f * f / z);
+                c.save();
+                c.translate(lx, pt);
+                fillShader(rad3(gr, al(0xFFFFE2B0, 0.95f * fade), al(0xFFFFD08A, 0.45f * fade), al(0xFFFFD08A, 0f), 0.25f));
+                c.drawRect(-gr, -gr, gr, gr, p);
+                c.restore();
+                p.setShader(null);
+            }
+        }
+        // neblina del horizonte sobre lo lejano
+        fillShader(hazeShader);
+        c.drawRect(0, hz - 2, w, hz + h * 0.16f, p);
+        p.setShader(null);
+    }
+
+    /** Auto rojo visto desde atrás (u = ancho en px; origen: centro de las llantas, sobre el suelo). */
+    private void drawCar(Canvas c, float ox, float oy, float u) {
+        // brillo de las luces sobre el camino, detrás del auto
+        glow(c, ox, oy + 0.02f * u, 0.95f * u, 0.28f, rad3(0.95f * u, al(0xFFFF2A2A, 0.55f), al(0xFFFF2A2A, 0.20f), al(0xFFFF2A2A, 0f), 0.45f));
+        // sombra
+        glow(c, ox, oy, 0.62f * u, 0.10f, rad3(0.62f * u, al(0xFF000000, 0.75f), al(0xFF000000, 0.40f), al(0xFF000000, 0f), 0.7f));
+        // llantas
+        fill(0xFF0C0D10);
+        for (int sd = -1; sd <= 1; sd += 2) {
+            float x0 = sd < 0 ? -0.475f : 0.355f;
+            rr(c, ox + x0 * u, oy - 0.20f * u, 0.12f * u, 0.20f * u, 0.03f * u);
+        }
+        // defensa inferior (plástico oscuro)
+        fillShader(lin(0, oy - 0.17f * u, 0, oy - 0.03f * u, 0xFF23252B, 0xFF0F1013));
+        rr(c, ox - 0.425f * u, oy - 0.17f * u, 0.85f * u, 0.14f * u, 0.05f * u);
+        p.setShader(null);
+
+        // carrocería (hatchback compacto, alto 0.82 u)
+        int bodyTop = light ? 0xFFE63B3B : 0xFFE2262C, bodyBot = 0xFF8E0F16;
+        fillShader(lin3(0, oy - 0.82f * u, 0, oy - 0.10f * u, bodyTop, mix(bodyTop, bodyBot, 0.45f), bodyBot, 0.55f));
+        path.reset();
+        path.moveTo(ox - 0.485f * u, oy - 0.15f * u);
+        path.lineTo(ox - 0.492f * u, oy - 0.47f * u);
+        path.quadTo(ox - 0.490f * u, oy - 0.54f * u, ox - 0.445f * u, oy - 0.58f * u);   // hombro
+        path.quadTo(ox - 0.405f * u, oy - 0.72f * u, ox - 0.33f * u, oy - 0.795f * u);   // pilar C
+        path.quadTo(ox, oy - 0.835f * u, ox + 0.33f * u, oy - 0.795f * u);               // techo
+        path.quadTo(ox + 0.405f * u, oy - 0.72f * u, ox + 0.445f * u, oy - 0.58f * u);
+        path.quadTo(ox + 0.490f * u, oy - 0.54f * u, ox + 0.492f * u, oy - 0.47f * u);
+        path.lineTo(ox + 0.485f * u, oy - 0.15f * u);
+        path.quadTo(ox + 0.48f * u, oy - 0.07f * u, ox + 0.40f * u, oy - 0.065f * u);
+        path.lineTo(ox - 0.40f * u, oy - 0.065f * u);
+        path.quadTo(ox - 0.48f * u, oy - 0.07f * u, ox - 0.485f * u, oy - 0.15f * u);
+        path.close();
+        c.drawPath(path, p);
+        p.setShader(null);
+
+        // brillo suave en el hombro
+        fillShader(lin(0, oy - 0.585f * u, 0, oy - 0.50f * u, al(0xFFFFFFFF, 0.28f), al(0xFFFFFFFF, 0f)));
+        path.reset();
+        path.moveTo(ox - 0.47f * u, oy - 0.52f * u);
+        path.quadTo(ox - 0.46f * u, oy - 0.575f * u, ox - 0.42f * u, oy - 0.585f * u);
+        path.lineTo(ox + 0.42f * u, oy - 0.585f * u);
+        path.quadTo(ox + 0.46f * u, oy - 0.575f * u, ox + 0.47f * u, oy - 0.52f * u);
+        path.close();
+        c.drawPath(path, p);
+        p.setShader(null);
+
+        // luneta grande
+        fillShader(lin(0, oy - 0.77f * u, 0, oy - 0.57f * u, 0xFF2B303B, 0xFF12141A));
+        path.reset();
+        path.moveTo(ox - 0.315f * u, oy - 0.575f * u);
+        path.lineTo(ox + 0.315f * u, oy - 0.575f * u);
+        path.quadTo(ox + 0.285f * u, oy - 0.70f * u, ox + 0.235f * u, oy - 0.765f * u);
+        path.lineTo(ox - 0.235f * u, oy - 0.765f * u);
+        path.quadTo(ox - 0.285f * u, oy - 0.70f * u, ox - 0.315f * u, oy - 0.575f * u);
+        path.close();
+        c.drawPath(path, p);
+        p.setShader(null);
+        fill(al(0xFFFFFFFF, 0.10f));
+        path.reset();
+        path.moveTo(ox - 0.22f * u, oy - 0.575f * u);
+        path.lineTo(ox - 0.10f * u, oy - 0.575f * u);
+        path.lineTo(ox + 0.03f * u, oy - 0.765f * u);
+        path.lineTo(ox - 0.12f * u, oy - 0.765f * u);
+        path.close();
+        c.drawPath(path, p);
+
+        // alerón y tercera luz de freno
+        fill(0xFF7C0C12);
+        rr(c, ox - 0.27f * u, oy - 0.793f * u, 0.54f * u, 0.026f * u, 0.012f * u);
+        fill(0xFFFF4A3C);
+        rr(c, ox - 0.14f * u, oy - 0.789f * u, 0.28f * u, 0.014f * u, 0.007f * u);
+
+        // junta del portón y manija
+        stroke(al(0xFF000000, 0.28f), 0.006f * u);
+        c.drawLine(ox - 0.285f * u, oy - 0.575f * u, ox - 0.285f * u, oy - 0.18f * u, p);
+        c.drawLine(ox + 0.285f * u, oy - 0.575f * u, ox + 0.285f * u, oy - 0.18f * u, p);
+        fillShader(lin(0, oy - 0.395f * u, 0, oy - 0.380f * u, 0xFFD9DCE2, 0xFF8D929C));
+        rr(c, ox - 0.09f * u, oy - 0.395f * u, 0.18f * u, 0.014f * u, 0.005f * u);
+        p.setShader(null);
+
+        // placa (en blanco, sin texto)
+        fill(0xFFE9EAEE);
+        rr(c, ox - 0.165f * u, oy - 0.325f * u, 0.33f * u, 0.095f * u, 0.012f * u);
+        stroke(0xFF4A4D55, 0.005f * u);
+        rr(c, ox - 0.165f * u, oy - 0.325f * u, 0.33f * u, 0.095f * u, 0.012f * u);
+
+        // luces traseras encendidas (altas, a los lados del portón)
+        for (int sd = -1; sd <= 1; sd += 2) {
+            glow(c, ox + sd * 0.385f * u, oy - 0.455f * u, 0.38f * u, 1f,
+                rad3(0.38f * u, al(0xFFFF2A22, 0.70f), al(0xFFFF2A22, 0.28f), al(0xFFFF2A22, 0f), 0.35f));
+            fillShader(lin3(ox + sd * 0.28f * u, 0, ox + sd * 0.49f * u, 0, 0xFFFF6A55, 0xFFEA1B1B, 0xFFA30B14, 0.5f));
+            path.reset();
+            path.moveTo(ox + sd * 0.283f * u, oy - 0.505f * u);
+            path.lineTo(ox + sd * 0.470f * u, oy - 0.560f * u);
+            path.quadTo(ox + sd * 0.492f * u, oy - 0.505f * u, ox + sd * 0.490f * u, oy - 0.385f * u);
+            path.lineTo(ox + sd * 0.283f * u, oy - 0.395f * u);
+            path.close();
+            c.drawPath(path, p);
+            p.setShader(null);
+            stroke(al(0xFFFFD2C8, 0.95f), 0.013f * u);
+            c.drawLine(ox + sd * 0.298f * u, oy - 0.480f * u, ox + sd * 0.462f * u, oy - 0.500f * u, p);
+            stroke(al(0xFFFFFFFF, 0.5f), 0.006f * u);
+            c.drawLine(ox + sd * 0.298f * u, oy - 0.440f * u, ox + sd * 0.458f * u, oy - 0.452f * u, p);
+            // reflector inferior
+            fill(al(0xFFFF3B2E, 0.75f));
+            rr(c, ox + (sd < 0 ? -0.40f : 0.31f) * u, oy - 0.145f * u, 0.09f * u, 0.022f * u, 0.008f * u);
+        }
+        // brillo de la tercera luz
+        glow(c, ox, oy - 0.785f * u, 0.16f * u, 1f, rad(0.16f * u, al(0xFFFF4A3C, 0.50f), al(0xFFFF4A3C, 0f)));
+    }
