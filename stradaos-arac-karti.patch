+            long now = SystemClock.uptimeMillis();
+            float dt = last == 0 ? 0f : Math.min(0.08f, (now - last) / 1000f);
+            last = now;
+            t += dt;
+            float target = playing ? 1f : 0.06f;
+            level += (target - level) * Math.min(1f, dt * 5f);
+            int n = Math.max(12, Math.min(56, (int) (w / (9 * s))));
+            float slot = w / (float) n, bw = slot * 0.56f, mid = h / 2f;
+            p.setStyle(Paint.Style.FILL);
+            for (int i = 0; i < n; i++) {
+                float ph = i * 0.73f;
+                float a1 = 0.5f * ((float) Math.sin(t * (2.1f + (i % 5) * 0.37f) + ph) + 1f);
+                float a2 = 0.5f * ((float) Math.sin(t * (3.3f + (i % 3) * 0.5f) + ph * 1.7f) + 1f);
+                float a = 0.6f * a1 + 0.4f * a2;
+                float pos = (i + 0.5f) / n;
+                float env = 0.40f + 0.60f * (float) Math.sin(Math.PI * pos);   // más altas en el centro
+                float bh = Math.max(3 * s, h * (0.10f + 0.90f * a * env) * level);
+                bh = Math.min(bh, h);
+                float edge = 1f - Math.abs(pos - 0.5f) * 1.2f;
+                p.setColor(al(accent, 0.45f + 0.55f * Math.max(0f, edge)));
+                float x = i * slot + (slot - bw) / 2f;
+                r.set(x, mid - bh / 2f, x + bw, mid + bh / 2f);
+                c.drawRoundRect(r, bw / 2f, bw / 2f, p);
+            }
+            if (playing || level > 0.075f) postInvalidateDelayed(40); else last = 0;
+        }
+    }
+
+    // ───────────────────────── letra de la canción ─────────────────────────
+
+    private static final HashMap<String, Object[]> CACHE = new HashMap<String, Object[]>();
+
+    private static String enc(String v) {
+        try { return URLEncoder.encode(v == null ? "" : v, "UTF-8"); } catch (Throwable e) { return ""; }
+    }
+
+    /** Quita lo que estorba al buscar: «(feat. …)», «[Remastered]» y los espacios de sobra. */
+    static String clean(String t) {
+        if (t == null) return "";
+        return t.replaceAll("\\s*[\\(\\[][^\\)\\]]*[\\)\\]]", "").replaceAll("\\s+", " ").trim();
+    }
+
+    static String firstArtist(String a) {
+        if (a == null) return "";
+        String x = a;
+        String[] seps = {",", ";", " & ", " feat", " ft.", " ft ", " x ", "/"};
+        for (String sp : seps) {
+            int i = x.toLowerCase().indexOf(sp);
+            if (i > 0) x = x.substring(0, i);
+        }
+        return x.trim();
+    }
+
+    private static long parseTag(String tag) {
+        try {
+            int i = tag.indexOf(':');
+            if (i < 1) return -1;
+            int mm = Integer.parseInt(tag.substring(0, i).trim());
+            double ss = Double.parseDouble(tag.substring(i + 1).trim());
+            return (long) (mm * 60000L + ss * 1000);
+        } catch (Throwable e) { return -1; }
+    }
+
+    /** Busca la letra en LRCLIB (gratis, sin cuenta). Devuelve {tiempos|null, líneas, sincronizada} o null si no hay. */
+    private static Object[] lookup(String title, String artist, long durMs) {
+        String key = title.toLowerCase() + "|" + artist.toLowerCase();
+        synchronized (CACHE) {
+            Object[] hit = CACHE.get(key);
+            if (hit != null) return hit;
+        }
+        try {
+            String q = "track_name=" + enc(title) + "&artist_name=" + enc(artist);
+            JSONObject o = null;
+            try {
+                String u = "https://lrclib.net/api/get?" + q + (durMs > 0 ? "&duration=" + (durMs / 1000) : "");
+                o = new JSONObject(new String(Net.get(u, 8000), "UTF-8"));
+            } catch (Throwable e) { o = null; }
+            if (o == null || (o.optString("syncedLyrics", "").length() == 0 && o.optString("plainLyrics", "").length() == 0)) {
+                JSONArray arr = new JSONArray(new String(Net.get("https://lrclib.net/api/search?" + q, 8000), "UTF-8"));
+                o = null;
+                JSONObject plain = null;
+                for (int i = 0; i < arr.length(); i++) {
+                    JSONObject x = arr.optJSONObject(i);
+                    if (x == null) continue;
+                    if (!x.isNull("syncedLyrics") && x.optString("syncedLyrics", "").length() > 0) { o = x; break; }
+                    if (plain == null && !x.isNull("plainLyrics") && x.optString("plainLyrics", "").length() > 0) plain = x;
+                }
+                if (o == null) o = plain;
+            }
+            if (o == null) return null;
+            Object[] res = null;
+            String syn = o.isNull("syncedLyrics") ? "" : o.optString("syncedLyrics", "");
+            if (syn.length() > 0) res = parseSynced(syn);
+            if (res == null) {
+                String pl = o.isNull("plainLyrics") ? "" : o.optString("plainLyrics", "");
+                ArrayList<String> ls = new ArrayList<String>();
+                for (String ln : pl.split("\n")) { ln = ln.trim(); if (ln.length() > 0) ls.add(ln); }
+                if (!ls.isEmpty()) res = new Object[]{null, ls.toArray(new String[0]), Boolean.FALSE};
+            }
+            if (res != null) synchronized (CACHE) {
+                if (CACHE.size() > 40) CACHE.clear();
+                CACHE.put(key, res);
+            }
+            return res;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    private static Object[] parseSynced(String syn) {
+        ArrayList<Object[]> items = new ArrayList<Object[]>();   // {ms, texto}
+        for (String ln : syn.split("\n")) {
+            ln = ln.trim();
+            int pos = 0;
+            ArrayList<Long> stamps = new ArrayList<Long>();
+            while (pos < ln.length() && ln.charAt(pos) == '[') {
+                int e = ln.indexOf(']', pos);
+                if (e < 0) break;
+                long ms = parseTag(ln.substring(pos + 1, e));
+                if (ms >= 0) stamps.add(ms);
+                pos = e + 1;
+            }
+            String tx = ln.substring(pos).trim();
+            for (Long ms : stamps) items.add(new Object[]{ms, tx});
+        }
+        if (items.isEmpty()) return null;
+        Collections.sort(items, new Comparator<Object[]>() {
+            public int compare(Object[] a, Object[] b) { return ((Long) a[0]).compareTo((Long) b[0]); }
+        });
+        long[] ts = new long[items.size()];
+        String[] ls = new String[items.size()];
+        for (int i = 0; i < ts.length; i++) { ts[i] = (Long) items.get(i)[0]; ls[i] = (String) items.get(i)[1]; }
+        return new Object[]{ts, ls, Boolean.TRUE};
+    }
+
+    /**
+     * La letra, en horizontal y con la línea que suena grande al centro (y la anterior y las siguientes más suaves).
+     * Con letra sincronizada la línea cambia en su momento; si solo hay letra sin tiempos, avanza según lo que lleva
+     * la canción. Se busca por internet (LRCLIB) con el título y el artista; se puede apagar en Ajustes.
+     */
+    static final class Lyrics extends View {
+        private final float s;
+        private final int text, muted;
+        private final String msgNone, msgLoad;
+        private final boolean online;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private String key = "";
+        private long[] times;
+        private String[] lines;
+        private boolean synced, loading;
+        private long posBase, posAt, dur, animAt;
+        private boolean playing, ticking;
+        private int idx = -1;
+
+        Lyrics(Context c, float scale, int textColor, int mutedColor, boolean online, String none, String load) {
+            super(c);
+            s = scale;
+            text = textColor;
+            muted = mutedColor;
+            this.online = online;
+            msgNone = none;
+            msgLoad = load;
+            p.setTextAlign(Paint.Align.CENTER);
+        }
+
+        private long curPos() {
+            long now = SystemClock.elapsedRealtime();
+            return Math.max(0, posBase + (playing ? now - posAt : 0));
+        }
+
+        void setTrack(String title, String artist, long durMs) {
+            dur = durMs;
+            String k = title == null && artist == null ? "" : clean(title) + "|" + clean(artist);
+            if (k.equals(key)) return;
+            key = k;
+            times = null; lines = null; synced = false; idx = -1; loading = false;
+            posBase = 0; posAt = SystemClock.elapsedRealtime();
+            invalidate();
+            if (!online || title == null || k.length() == 0) return;
+            loading = true;
+            final String kk = k, t = clean(title), a = firstArtist(artist);
+            final long d = durMs;
+            new Thread(new Runnable() { public void run() {
+                final Object[] res = lookup(t, a, d);
+                post(new Runnable() { public void run() {
+                    if (!kk.equals(key)) return;
+                    loading = false;
+                    if (res != null) { times = (long[]) res[0]; lines = (String[]) res[1]; synced = Boolean.TRUE.equals(res[2]); }
+                    idx = -1;
+                    animAt = 0;
+                    invalidate();
+                    kick();
+                }});
+            }}).start();
+        }
+
+        void setPos(long ms) {
+            posBase = ms;
+            posAt = SystemClock.elapsedRealtime();
+            invalidate();
+        }
+
+        void setPlaying(boolean on) {
+            if (on == playing) return;
+            posBase = curPos();
+            posAt = SystemClock.elapsedRealtime();
+            playing = on;
+            kick();
+        }
+
+        private final Runnable tick = new Runnable() { public void run() {
+            ticking = false;
+            invalidate();
+            if (playing && lines != null) kick();
+        }};
+
+        private void kick() {
+            if (ticking || lines == null || !playing) return;
+            ticking = true;
+            postDelayed(tick, 150);
+        }
+
+        @Override protected void onDetachedFromWindow() {
+            super.onDetachedFromWindow();
+            removeCallbacks(tick);
+            ticking = false;
+        }
+
+        private void update() {
+            if (lines == null) return;
+            int n = lines.length, i = -1;
+            long pos = curPos();
+            if (synced && times != null) {
+                for (int k = 0; k < n; k++) { if (times[k] <= pos + 200) i = k; else break; }
+            } else i = dur > 0 ? (int) Math.min(n - 1, pos * n / dur) : 0;
+            if (i != idx) { idx = i; animAt = SystemClock.uptimeMillis(); }
+        }
+
+        private ArrayList<String> wrap(String t, float maxW) {
+            ArrayList<String> out = new ArrayList<String>();
+            String[] words = t.split(" ");
+            StringBuilder cur = new StringBuilder();
+            for (String wd : words) {
+                if (wd.length() == 0) continue;
+                String tryS = cur.length() == 0 ? wd : cur + " " + wd;
+                if (cur.length() > 0 && p.measureText(tryS) > maxW) { out.add(cur.toString()); cur = new StringBuilder(wd); }
+                else { cur = new StringBuilder(tryS); }
+            }
+            if (cur.length() > 0) out.add(cur.toString());
+            if (out.isEmpty()) out.add("");
+            return out;
+        }
+
+        private String fit(String t, float maxW) {
+            if (p.measureText(t) <= maxW) return t;
+            int n = p.breakText(t, true, maxW, null);
+            return t.substring(0, Math.max(0, n - 1)) + "…";
+        }
+
+        private String lineAt(int i) {
+            if (lines == null || i < 0 || i >= lines.length) return null;
+            String t = lines[i];
+            return t.length() == 0 ? "♪" : t;
+        }
+
+        @Override protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            if (w <= 0 || h <= 0 || !online || key.length() == 0) return;
+            float cx = w / 2f, maxW = w - 8 * s;
+            String msg = loading ? msgLoad : lines == null ? msgNone : null;
+            if (msg != null) {
+                p.setTypeface(Typeface.DEFAULT);
+                p.setTextSize(15 * s);
+                p.setColor(al(muted, 0.9f));
+                c.drawText(msg, cx, h / 2f + 5 * s, p);
+                return;
+            }
+            update();
+            String curT = idx < 0 ? "♪" : lineAt(idx);
+            float size = Math.min(34 * s, h * 0.34f);
+            ArrayList<String> cl;
+            p.setTypeface(Typeface.DEFAULT_BOLD);
+            while (true) {
+                p.setTextSize(size);
+                cl = wrap(curT, maxW);
+                if (cl.size() <= 2 || size <= 17 * s) break;
+                size -= 2 * s;
+            }
+            float lh = size * 1.2f, block = cl.size() * lh, top = h / 2f - block / 2f;
+            float a = Math.max(0f, Math.min(1f, (SystemClock.uptimeMillis() - animAt) / 300f));
+            float dy = (1f - a) * size * 1.3f;
+            c.save();
+            c.translate(0, dy);
+            p.setColor(al(text, 0.5f + 0.5f * a));
+            for (int i = 0; i < cl.size(); i++) c.drawText(cl.get(i), cx, top + lh * i + size * 0.92f, p);
+            // la anterior y las que vienen: más chicas y suaves
+            float sec = size * 0.58f, gap = sec * 0.55f;
+            p.setTypeface(Typeface.DEFAULT);
+            p.setTextSize(sec);
+            String pv = idx >= 1 ? lineAt(idx - 1) : null;
+            if (pv != null && top - gap - sec * 0.85f >= -dy) { p.setColor(al(muted, 0.55f)); c.drawText(fit(pv, maxW), cx, top - gap, p); }
+            String n1 = lineAt(idx + 1), n2 = lineAt(idx + 2);
+            float by = top + block + gap + sec * 0.8f;
+            if (n1 != null && by + sec * 0.3f <= h - dy) { p.setColor(al(muted, 0.95f)); c.drawText(fit(n1, maxW), cx, by, p); }
+            if (n2 != null && by + sec * 1.5f + sec * 0.3f <= h - dy) { p.setColor(al(muted, 0.5f)); c.drawText(fit(n2, maxW), cx, by + sec * 1.5f, p); }
+            c.restore();
+            if (a < 1f) postInvalidateDelayed(16);
+        }
+    }
+
+    // ───────────────────────── miniatura de la galería ─────────────────────────
+
+    /** Miniatura: columna del carro a la izquierda, la tarjeta de música grande con las barras y la barra de apps. */
+    static final class Thumb extends View {
