+                rr(c, x0 + gap * 1.5f, cy0 + gap * 1.5f, x0 + gap * 1.5f + aw, cy0 + gap * 1.5f + aw, aw * 0.22f, light ? 0x14000000 : 0x1FFFFFFF);
+                rr(c, x0 + gap * 1.5f + aw + gap, cy0 + gap * 1.8f, x0 + gap * 1.5f + aw + gap + (w - pad - x0) * 0.34f, cy0 + gap * 1.8f + aw * 0.22f, aw * 0.1f, text);
+                rr(c, x0 + gap * 1.5f + aw + gap, cy0 + gap * 1.8f + aw * 0.4f, x0 + gap * 1.5f + aw + gap + (w - pad - x0) * 0.22f, cy0 + gap * 1.8f + aw * 0.58f, aw * 0.08f, muted);
+                // la letra: una línea grande y dos suaves
+                float lx = x0 + (w - pad - x0) * 0.18f, lw = (w - pad - x0) * 0.64f, ly = cy0 + (cy1 - cy0) * 0.50f;
+                rr(c, lx + lw * 0.2f, ly, lx + lw * 0.8f, ly + (cy1 - cy0) * 0.06f, 3, muted);
+                rr(c, lx, ly + (cy1 - cy0) * 0.10f, lx + lw, ly + (cy1 - cy0) * 0.17f, 3, text);
+                rr(c, lx + lw * 0.15f, ly + (cy1 - cy0) * 0.21f, lx + lw * 0.85f, ly + (cy1 - cy0) * 0.26f, 3, muted);
+                // botones: anterior, reproducir, siguiente
+                float by = cy1 - (cy1 - cy0) * 0.13f, mx = (x0 + w - pad) / 2f, br = (cy1 - cy0) * 0.055f;
+                p.setStyle(Paint.Style.FILL);
+                p.setColor(muted);
+                c.drawCircle(mx - br * 4.2f, by, br * 0.8f, p);
+                c.drawCircle(mx + br * 4.2f, by, br * 0.8f, p);
+                p.setColor(Main.RED);
+                c.drawCircle(mx, by, br * 1.5f, p);
+            }
+            // barra de apps compacta
+            float pw = portrait ? w - 2 * pad : (w - pad - (pad + w * 0.27f + gap * 2)) * 0.6f;
+            float px = portrait ? pad : (w - pad) - pw - ((w - pad - (pad + w * 0.27f + gap * 2)) - pw) / 2f;
+            card(c, px, pillY, px + pw, pillY + pillH, pillH * 0.36f);
+            if (selected) {
+                p.setStyle(Paint.Style.STROKE);
+                p.setStrokeWidth(Math.max(2f, s * 1.6f));
+                p.setColor(Main.RED);
+                r.set(1, 1, w - 1, h - 1);
+                c.drawRoundRect(r, rad, rad, p);
+            }
+        }
+
+        private void eq(Canvas c, float l, float t, float rt, float b, int color) {
+            int n = 18;
+            float cx = (l + rt) / 2f, cy = t + (b - t) * 0.40f, span = (rt - l) * 0.46f, slot = span / n, bw = slot * 0.55f;
+            float maxH = (b - t) * 0.16f;
+            p.setStyle(Paint.Style.FILL);
+            p.setShader(null);
+            for (int i = 0; i < n; i++) {
+                float pos = (i + 0.5f) / n;
+                float v = (0.35f + 0.65f * Math.abs((float) Math.sin(i * 1.7f))) * (0.4f + 0.6f * (float) Math.sin(Math.PI * pos));
+                float bh = Math.max(2f, maxH * v);
+                float x = cx - span / 2f + i * slot;
+                p.setColor(al(Main.RED, 0.5f + 0.5f * (float) Math.sin(Math.PI * pos)));
+                r.set(x, cy - bh, x + bw, cy + bh);
+                c.drawRoundRect(r, bw / 2f, bw / 2f, p);
+            }
+        }
+    }
+}
