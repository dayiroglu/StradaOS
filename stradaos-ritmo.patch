+            if (bg == null || bg.getWidth() != w || bg.getHeight() != h) {
+                try {
+                    bg = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+                    Faro.paint(new Canvas(bg), w, h, light, Main.RED);
+                    Aurora.grain(bg, Faro.grain(light));
+                } catch (Throwable e) { bg = null; }
+            }
