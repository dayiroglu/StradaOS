+                if (a <= 0.02f) continue;
+                p.setColor(al(text, 0.34f * a));
+                r.set(cx - lane - 1.3f * s, y, cx - lane + 1.3f * s, y + dash);
+                c.drawRoundRect(r, 1.3f * s, 1.3f * s, p);
+                r.set(cx + lane - 1.3f * s, y, cx + lane + 1.3f * s, y + dash);
+                c.drawRoundRect(r, 1.3f * s, 1.3f * s, p);
+            }
+            // bordes de la calzada, con el color del tema
+            float seg = 6 * s;
+            for (float y = 0; y < h; y += seg) {
+                float a = fade(y + seg / 2f, h);
+                if (a <= 0.02f) continue;
