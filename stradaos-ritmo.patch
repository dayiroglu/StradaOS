+                p.setStrokeWidth(Math.max(1.5f, s * 1.1f));
+                p.setColor(muted);
+                c.drawCircle(pad + colW / 2f, pad + colW * 0.42f, colW * 0.36f, p);
+                float carT = pad + colW * 0.95f;
+                p.setStyle(Paint.Style.FILL);
+                p.setColor(al(Main.RED, 0.55f));
+                c.drawRect(pad + colW * 0.06f, carT, pad + colW * 0.06f + 1.5f * s, h - pad, p);
+                c.drawRect(pad + colW * 0.94f - 1.5f * s, carT, pad + colW * 0.94f, h - pad, p);
+                rr(c, pad + colW * 0.3f, carT + (h - pad - carT) * 0.12f, pad + colW * 0.7f, h - pad - (h - pad - carT) * 0.05f, colW * 0.12f, Main.RED);
+                float x0 = pad + colW + gap * 2, topH = h * 0.06f;
+                rr(c, x0, pad, x0 + w * 0.10f, pad + topH, topH * 0.4f, text);
+                rr(c, x0 + w * 0.12f, pad, x0 + w * 0.22f, pad + topH, topH * 0.4f, muted);
