+    /** El valor guardado sigue siendo «ritmo2» (así quien ya lo eligió lo conserva); el tema se llama solo «Ritmo». */
+    static final String ID = "ritmo2";
+
+    private static int al(int c, float a) {
+        int a0 = (c >>> 24) & 0xFF;
+        return (Math.max(0, Math.min(255, (int) (a0 * a))) << 24) | (c & 0xFFFFFF);
+    }
+
+    // ───────────────────────── calzada que pasa bajo el carro ─────────────────────────
+
+    /**
+     * Rayas de carril y bordes de la calzada que corren hacia abajo (el carro va hacia arriba, visto desde arriba).
+     * La velocidad real manda: detenido queda quieto (y no gasta batería); a 100 km/h pasan rápido.
+     */
+    static final class Flow extends View {
+        private final float s;
+        private final int text, accent;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF r = new RectF();
+        private float speed, shown, off, carHalf;
+        private long last;
+
+        Flow(Context c, float scale, int textColor, int accentColor) {
+            super(c);
+            s = scale;
+            text = textColor;
+            accent = accentColor;
+        }
+
+        /** Mitad del ancho del carro en px (para dejarle sitio a los lados). */
+        void setCarHalf(float px) { carHalf = px; }
+
+        void setSpeed(float kmh) {
+            boolean was = speed > 0.2f || shown > 0.3f;
+            speed = kmh < 2 ? 0 : Math.min(kmh, 220f);
+            if (!was && speed > 0.2f) { last = 0; invalidate(); }
+        }
+
+        private static float fade(float y, float h) {
+            float t = y / h;
+            return Math.max(0f, Math.min(1f, t / 0.22f)) * Math.max(0f, Math.min(1f, (1f - t) / 0.16f));
+        }
+
+        @Override protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            if (w <= 0 || h <= 0) return;
+            long now = SystemClock.uptimeMillis();
+            float dt = last == 0 ? 0f : Math.min(0.06f, (now - last) / 1000f);
+            last = now;
+            shown += (speed - shown) * Math.min(1f, dt * 2.5f);
+            if (Math.abs(speed - shown) < 0.3f) shown = speed;
+            off += shown * 2.3f * s * dt;
+
+            float cx = w / 2f;
+            float edge = w / 2f - 10 * s;
+            float half = carHalf > 0 ? carHalf : w * 0.2f;
+            float lane = Math.min(edge - 12 * s, Math.max(half + 16 * s, edge * 0.64f));
+            p.setStyle(Paint.Style.FILL);
