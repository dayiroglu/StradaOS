+import android.os.SystemClock;
+import android.view.View;
+
+
+/**
+ * Tema «Ritmo»: los colores y el fondo de Faro, con una tarjeta de música grande al centro (carátula, canción y artista
+ * arriba, barras que bailan en el medio, línea de tiempo que se puede arrastrar y los botones anterior / reproducir /
+ * siguiente aparte), el carro grande a la izquierda con la calzada que corre según la velocidad, y debajo de la música
+ * los mantenimientos y el clima. Android Auto y el cambio claro / oscuro van a los lados de la barra de apps.
+ *
+ * Aquí viven las vistas nuevas (barras y calzada) y la miniatura de la galería; el armado está en Main.
+ */
+final class Ritmo {
+    private Ritmo() { }
+
+    /** El valor guardado sigue siendo «ritmo2» (así quien ya lo eligió lo conserva); el tema se llama solo «Ritmo». */
+    static final String ID = "ritmo2";
+
+    // el carro es una foto de un Auris visto desde arriba (assets/ritmo): proporción ancho/alto y posición de los faros
+    // y de las luces traseras como fracción del recuadro del carro
+    static final float CAR_ASPECT = 732f / 1210f;
+    static final float LAMP_X = 0.158f, LAMP_Y = 0.068f;
+    static final float TAIL_X = 0.16f, TAIL_Y = 0.835f;
+
+    private static int al(int c, float a) {
+        int a0 = (c >>> 24) & 0xFF;
+        return (Math.max(0, Math.min(255, (int) (a0 * a))) << 24) | (c & 0xFFFFFF);
+    }
+
+    // ───────────────────────── calzada que pasa bajo el carro ─────────────────────────
+
+    /**
+     * Rayas de carril y bordes de la calzada que corren hacia abajo (el carro va hacia arriba, visto desde arriba).
+     * La velocidad real manda: detenido queda quieto (y no gasta batería); a 100 km/h pasan rápido.
+     */
+    static final class Flow extends View {
+        private final float s;
+        private final int text, accent;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF r = new RectF();
+        private float speed, shown, off, carHalf;
+        private long last;
+
+        Flow(Context c, float scale, int textColor, int accentColor) {
+            super(c);
+            s = scale;
+            text = textColor;
+            accent = accentColor;
+        }
+
+        /** Mitad del ancho del carro en px (para dejarle sitio a los lados). */
+        void setCarHalf(float px) { carHalf = px; }
+
+        void setSpeed(float kmh) {
+            boolean was = speed > 0.2f || shown > 0.3f;
+            speed = kmh < 2 ? 0 : Math.min(kmh, 220f);
+            if (!was && speed > 0.2f) { last = 0; invalidate(); }
+        }
+
+        private static float fade(float y, float h) {
+            float t = y / h;
+            return Math.max(0f, Math.min(1f, t / 0.22f)) * Math.max(0f, Math.min(1f, (1f - t) / 0.16f));
+        }
+
+        @Override protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            if (w <= 0 || h <= 0) return;
+            long now = SystemClock.uptimeMillis();
+            float dt = last == 0 ? 0f : Math.min(0.06f, (now - last) / 1000f);
+            last = now;
+            shown += (speed - shown) * Math.min(1f, dt * 2.5f);
+            if (Math.abs(speed - shown) < 0.3f) shown = speed;
+            off += shown * 2.3f * s * dt;
+
+            float cx = w / 2f;
+            float edge = w / 2f - 10 * s;
+            float half = carHalf > 0 ? carHalf : w * 0.2f;
+            float lane = Math.min(edge - 12 * s, Math.max(half + 16 * s, edge * 0.64f));
+            p.setStyle(Paint.Style.FILL);
+
+            // rayas de carril
+            float period = 64 * s, dash = 26 * s, o = off % period;
+            for (float y = o - period; y < h; y += period) {
+                float a = fade(y + dash / 2f, h);
+                if (a <= 0.02f) continue;
+                p.setColor(al(text, 0.34f * a));
+                r.set(cx - lane - 1.3f * s, y, cx - lane + 1.3f * s, y + dash);
+                c.drawRoundRect(r, 1.3f * s, 1.3f * s, p);
+                r.set(cx + lane - 1.3f * s, y, cx + lane + 1.3f * s, y + dash);
+                c.drawRoundRect(r, 1.3f * s, 1.3f * s, p);
+            }
+            // bordes de la calzada, con el color del tema
+            float seg = 6 * s;
+            for (float y = 0; y < h; y += seg) {
+                float a = fade(y + seg / 2f, h);
+                if (a <= 0.02f) continue;
+                p.setColor(al(accent, 0.55f * a));
+                c.drawRect(cx - edge - 1.3f * s, y, cx - edge + 1.3f * s, y + seg + 0.5f, p);
+                c.drawRect(cx + edge - 1.3f * s, y, cx + edge + 1.3f * s, y + seg + 0.5f, p);
+            }
+            // bandas sonoras del borde: dan la sensación de velocidad
+            float p2 = 18 * s, o2 = off % p2;
+            for (float y = o2 - p2; y < h; y += p2) {
+                float a = fade(y, h);
+                if (a <= 0.02f) continue;
+                p.setColor(al(accent, 0.30f * a));
+                c.drawRect(cx - edge + 1.3f * s, y, cx - edge + 7 * s, y + 2.2f * s, p);
+                c.drawRect(cx + edge - 7 * s, y, cx + edge - 1.3f * s, y + 2.2f * s, p);
+            }
+            if (speed > 0.2f || shown > 0.3f) postInvalidateDelayed(33); else last = 0;
+        }
+    }
+
+    // ───────────────────────── escala y aguja del velocímetro ─────────────────────────
+
+    /**
+     * Números chicos 20-40-…-180 con una raya corta por fuera del aro (sin aguja).
+     * Mismo arco que FaroGauge: empieza a los 135° y barre 270°. «max» es 200 km/h (o 120 mph).
+     */
+    static void dial(Canvas c, Paint pNum, Paint pLine, float cx, float cy, float r, float val, float max,
+                     int text, int muted) {
+        float step = 20f;
+        pNum.setTextSize(r * 0.105f);
+        for (float v = step; v <= max - step + 0.01f; v += step) {
+            double a = Math.toRadians(135.0 + 270.0 * v / max);
+            float cs = (float) Math.cos(a), sn = (float) Math.sin(a);
+            boolean near = Math.abs(val - v) < step * 0.5f;
+            pNum.setColor(near ? text : muted);
+            // raya corta pegada al aro, justo frente a cada número
+            pLine.setStyle(Paint.Style.STROKE);
+            pLine.setColor(near ? text : muted);
+            pLine.setStrokeWidth(Math.max(1.5f, r * 0.022f));
+            c.drawLine(cx + cs * r * 1.055f, cy + sn * r * 1.055f, cx + cs * r * 1.10f, cy + sn * r * 1.10f, pLine);
+            // el número se aleja de la raya lo justo según su ancho (los de los costados son más anchos que altos)
+            String lab = String.valueOf(Math.round(v));
+            float hw = pNum.measureText(lab) / 2f, hh = r * 0.05f;
+            float rl = r * 1.12f + hw * Math.abs(cs) + hh * Math.abs(sn);
+            c.drawText(lab, cx + cs * rl, cy + sn * rl - (pNum.ascent() + pNum.descent()) / 2f, pNum);
+        }
+    }
+
+    // ───────────────────────── barras que bailan ─────────────────────────
+
+    /** Ecualizador animado: baila cuando suena la música y se aquieta cuando está en pausa. */
+    static final class Eq extends View {
+        private final float s;
+        private final int accent, text;
+        private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF r = new RectF();
+        private boolean playing;
+        private float level = 0.06f;
+        private long last;
+        private float t;
+
+        Eq(Context c, float scale, int accentColor, int textColor) {
+            super(c);
+            s = scale;
+            accent = accentColor;
+            text = textColor;
+        }
+
+        void setPlaying(boolean on) {
+            if (on == playing) return;
+            playing = on;
+            last = 0;
+            invalidate();
+        }
+
+        @Override protected void onDraw(Canvas c) {
+            int w = getWidth(), h = getHeight();
+            if (w <= 0 || h <= 0) return;
+            long now = SystemClock.uptimeMillis();
+            float dt = last == 0 ? 0f : Math.min(0.08f, (now - last) / 1000f);
