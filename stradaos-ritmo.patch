diff --git a/app/src/main/java/com/stradaos/launcher/Faro.java b/app/src/main/java/com/stradaos/launcher/Faro.java
index 3695f74..aa906d4 100644
--- a/app/src/main/java/com/stradaos/launcher/Faro.java
+++ b/app/src/main/java/com/stradaos/launcher/Faro.java
@@ -419,8 +419,11 @@ final class Faro {
      * Recuadro del carro dentro de una vista de vw×vh px. La sombra (difuminada, corrida a la derecha y abajo) queda
      * entera DENTRO de la vista: así nunca se ve cortada en la base ni a los lados.
      */
-    static RectF carRect(float vw, float vh) {
-        float ch = Math.min(vh / 1.16f, vw / 1.62f / CAR_ASPECT), cw = ch * CAR_ASPECT;
+    static RectF carRect(float vw, float vh) { return carRect(vw, vh, CAR_ASPECT); }
+
+    /** Igual, para un carro con otra proporción (Ritmo usa una foto). */
+    static RectF carRect(float vw, float vh, float aspect) {
+        float ch = Math.min(vh / 1.16f, vw / 1.62f / aspect), cw = ch * aspect;
         float slack = Math.max(0, vh - ch * 1.16f);
         float l = (vw - cw) / 2, t = ch * 0.045f + slack * 0.3f;
         return new RectF(l, t, l + cw, t + ch);
@@ -455,11 +458,15 @@ final class Faro {
     }
 
     /** El carro del color elegido, recortado (JPG + máscara de transparencia), al tamaño exacto. */
-    static Bitmap carBitmap(Context ctx, String color, int w, int h, boolean dark) {
-        String key = color + ":" + w + "x" + h + ":" + dark;
+    static Bitmap carBitmap(Context ctx, String color, int w, int h, boolean dark) { return carBitmap(ctx, color, w, h, dark, false); }
+
+    /** «photo»: el carro de Ritmo (assets/ritmo: un JPG por color y una sola máscara común). */
+    static Bitmap carBitmap(Context ctx, String color, int w, int h, boolean dark, boolean photo) {
+        String key = (photo ? "p:" : "") + color + ":" + w + "x" + h + ":" + dark;
         Bitmap b = carCache.get(key);
         if (b != null && !b.isRecycled()) return b;
